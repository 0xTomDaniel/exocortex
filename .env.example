# Secret-only local bridge for Hermes smoke and owner template inventories.
# Keep ordinary non-secret config in TOML under profiles/.
# Production/operator runs should prefer Phase injection, for example:
#   phase run --app exo-executive-agent --env dev --path /tom/local -- <command>
# If a local dotenv-compatible bridge is needed, use Node's built-in dotenv
# support or the consuming tool's native env support. Do not add dotenv by
# default, and do not use VITE_ prefixes for secrets.

# Profiles reuse these generic names inside each per-instance Phase path, e.g.
# /tom/local, /tom/personal-agent, /alex/personal-agent, or
# /sam/personal-agent. Do not prefix names with the owner; the Phase path is
# the owner boundary.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Optional. Not required when the instance uses Hermes Codex OAuth / ChatGPT
# Pro login through Hermes.
OPENAI_API_KEY=
